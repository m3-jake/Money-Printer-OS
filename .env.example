# SAFE DEFAULT
MODE=paper
PAPER_START_SOL=1
SCAN_INTERVAL_SEC=8
DASHBOARD_PORT=8792
OPEN_DASHBOARD=true

# EXTERNAL API UNIT ECONOMICS
# Existing market-feed guard was 120 requests/minute; keep 120 unless intentionally changed.
MARKET_REQUESTS_PER_MINUTE=120
# 0 = unlimited (preserves historical Helius behavior). Set a positive cap only when desired.
HELIUS_REQUESTS_PER_MINUTE=0
# Optional explicit per-request costs. Leave blank when the provider is not billed per request or the rate is unknown.
DEXSCREENER_COST_PER_REQUEST_USD=
GECKOTERMINAL_COST_PER_REQUEST_USD=
HELIUS_COST_PER_REQUEST_USD=

# DISCOVERY / ENTRY
MAX_CANDIDATES=240
MIN_LIQUIDITY_USD=1500
MIN_H1_VOLUME_USD=1000
MAX_FDV_USD=50000000
MAX_PAIR_AGE_HOURS=168
MAX_TOP10_HOLDER_PCT=55
MAX_TOP1_HOLDER_PCT=18

# POSITION / PORTFOLIO RISK
TRADE_SIZE_SOL=0.05
RISK_PER_TRADE_PCT=1.0
MAX_POSITION_SOL=0.15
MAX_OPEN_POSITIONS=3
MAX_TOTAL_EXPOSURE_SOL=0.45
DAILY_LOSS_LIMIT_SOL=0.35
HOURLY_LOSS_LIMIT_SOL=0.18
MAX_CONSECUTIVE_LOSSES=4
TAKE_PROFIT_1_PCT=12
TAKE_PROFIT_1_SELL_PCT=35
TAKE_PROFIT_2_PCT=25
TAKE_PROFIT_2_SELL_PCT=35
STOP_LOSS_PCT=8
TRAILING_STOP_PCT=7
BREAK_EVEN_TRIGGER_PCT=8
MAX_HOLD_MIN=60
COOLDOWN_MIN=30
MAX_SLIPPAGE_BPS=300
SIMULATED_SLIPPAGE_BPS=80
SIMULATED_FEE_BPS=25
MIN_SOL_RESERVE=0.02

# LIVE EXECUTION — leave empty for paper mode
JUPITER_API_KEY=
BS58_PRIVATE_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
BACKUP_RPC_URLS=
ENABLE_LIVE_TRADING=false

# HOLDER LOOKUPS — the free public RPC answers 429 to getTokenLargestAccounts, so holder checks and Wallet Intel
# stay blind without this. Paste a keyed RPC URL (e.g. Helius: https://mainnet.helius-rpc.com/?api-key=...).
# Only holder lookups use it (2 calls per token checked). Daily cap on those calls; 0 = no cap.
HOLDER_RPC_URL=
HOLDER_RPC_DAILY_CALLS=25000

# OPTIONAL ALERTS
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=


# Optional providers / fast-path adapters
JITO_ENABLED=false
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf/api/v1/transactions
JITO_AUTH=
SOCIAL_FEED_URL=
SOCIAL_FEED_TOKEN=
PROGRAM_LOG_IDS=
DIRECT_STREAM_ENABLED=false

# V9 research/live separation
# live mode creates proposals; dashboard approval is required for automatic real entries and exits
# AUTONOMY is adjusted at runtime from the dashboard (0-5)

# V12 ALPHA GRAPH / EDGE PROVER DATA PLANE
ALPHA_WORKER_ENABLED=false            # the hypothesis-miner child; off by default (batch 11), research belongs in the Evolution Lab
ALPHA_TX_MIN_EDGE=45
# Strongly recommended for full parsed transaction coverage. Public RPC fallback is lower coverage.
HELIUS_API_KEY=

# Optional custom parsed transaction feed; should accept ?mint=<mint>&limit=<n> and return {events:[...]}.
TX_FEED_URL=
TX_FEED_TOKEN=

# EVOLUTION LAB LINK (alpha.53+)
# Strategy research runs in the separate Money Printer Evolution Lab app (research workhorse only).
# A lab on this machine is found automatically through <data>/lab-link/. A lab on another machine is
# reached through the same signed bridge the network mesh uses:
#   MONEY_PRINTER_BRIDGE_DIR=<shared folder, e.g. Dropbox/BingAgentLab-Exchange/mpo-network>
#   MONEY_PRINTER_BRIDGE_KEY=<shared secret, identical on every machine>
# Champions are re-validated locally and only ever applied in paper mode.

# DISTRIBUTED RESEARCH CLUSTER — moved to the Evolution Lab; the trader ignores these keys
# On exactly one trusted machine set CLUSTER_HOST=true. That app becomes the coordinator.
CLUSTER_HOST=false
CLUSTER_PORT=8798
CLUSTER_TOKEN=
# Other machines: set this to the host's private-LAN/Tailscale URL, e.g. http://100.x.x.x:8798
CLUSTER_HUB_URL=
CLUSTER_WORKER_ID=
# 0/blank = automatic; otherwise cap concurrent evaluator slots (1-16)
CLUSTER_WORKER_SLOTS=
CLUSTER_CLAIM_TTL_MS=120000

# Local-only by default. Use 0.0.0.0 only for trusted same-LAN phone testing.
DASHBOARD_HOST=127.0.0.1

# UPDATE CHANNEL (docs/RELEASE-CHANNEL.md)
# Where an installed copy looks for signed releases. Blank = this repository's GitHub Releases
# (https://github.com/m3-jake/Money-Printer-OS, newest published release). Also accepts
# .../releases/tag/<tag> to pin a release, or a plain https://host/dir holding manifest.json + app.asar.
MONEY_PRINTER_UPDATE_URL=
# Needed only while that GitHub repository is private: a fine-grained token limited to it with
# Contents: Read-only. It only fetches; the Ed25519 signature check still decides what is trusted.
MONEY_PRINTER_UPDATE_TOKEN=

# ROBINHOOD AUTO TRADER (docs/ROBINHOOD-AUTO-TRADER.md) — official Crypto Trading API, paper-first, Bitcoin-primary.
# Keys are created at https://robinhood.com/account/crypto; the HUD "Save to .env" button writes the first three lines.
#ROBINHOOD_API_KEY=                      # rh-api-<uuid>
#ROBINHOOD_PRIVATE_KEY=                  # base64 32-byte Ed25519 seed (64-byte seed||publicKey values are rejected)
#ROBINHOOD_REAL_ENABLED=false            # must be exactly true before the session can be armed or any real order placed
#ROBINHOOD_AUTOSTART=true                # false keeps the loop inert (no longer follows POLYMARKET_AUTOSTART)
#ROBINHOOD_COLLECT_QUOTES=true           # §23: sample quotes every tick while the app runs, even with autopilot off (public Coinbase feed without keys)
#ROBINHOOD_WARM_START=true               # §23: on boot refill the tape from robinhood-tape/, then backfill holes from public 1-minute candles
#ROBINHOOD_EXPLORE_ENABLED=true          # §23: second paper book robinhood-paper-explore.json; EXPLORATION (NOT A STRATEGY), never qualifies
#ROBINHOOD_API=https://trading.robinhood.com
#ROBINHOOD_ORDER_API=v2                  # v1 only if the key lacks the fee-tier orders scope
#ROBINHOOD_MAX_ORDER_USD=25              # ceiling per real order (also caps the primary multiplier)
#ROBINHOOD_MAX_OPEN=5                    # ceiling on open real rows
#ROBINHOOD_DAILY_LOSS_CAP_USD=50         # realized real loss today that stops new entries and disables real autopilot
#ROBINHOOD_PRICE_TOLERANCE=0.02          # max drift between preview and fresh quote
#ROBINHOOD_SYMBOLS=BTC-USD,ETH-USD,SOL-USD   # default universe; the primary symbol is always listed and sampled first
#ROBINHOOD_PRIMARY_SYMBOL=BTC-USD        # Bitcoin specialization: sampled first, weighted in candidate ranking
#ROBINHOOD_PRIMARY_WEIGHT=1.5            # multiplier on the primary symbol's expectedMove/cost score (max 10)
#ROBINHOOD_PRIMARY_ORDER_MULT=1.0        # primary autopilot order = orderUsd x this (max 2.0), never above ROBINHOOD_MAX_ORDER_USD
#ROBINHOOD_TICK_MS=15000                 # loop and tape cadence (min 5000)
#ROBINHOOD_FEE_RATIO_FALLBACK=0.0085
#ROBINHOOD_PAPER_START_USD=1000
#ROBINHOOD_QUAL_MIN_CLOSES=20
#ROBINHOOD_QUAL_MIN_HIT_RATE=0.45
#ROBINHOOD_QUAL_MIN_PROFIT_FACTOR=1.3
#ROBINHOOD_QUAL_WINDOW_DAYS=30
# Robinhood Evolution (docs/ROBINHOOD-AUTO-TRADER.md section 22): paper-only self-improvement. Champions are PROPOSED in the HUD;
# they touch the paper params only (never real autopilot) and are applied automatically only when AUTOPROMOTE is exactly true.
#ROBINHOOD_EVOLVE_ENABLED=false          # exactly true schedules the in-process search every 6 h (the HUD "Run now" button always works)
#ROBINHOOD_EVOLVE_INTERVAL_MIN=360       # scheduled generation cadence from the loop tick
#ROBINHOOD_EVOLVE_CANDIDATES=24          # bounded mutations evaluated per generation (max 200), time-boxed to 20 s
#ROBINHOOD_EVOLVE_MIN_GAIN=0.15          # champion must beat the incumbent's test score by this fraction
#ROBINHOOD_EVOLVE_AUTOPROMOTE=false      # true applies champions to the PAPER autopilot without the APPLY click (resets qualification)
#ROBINHOOD_EVOLVE_MIN_TAPE_DAYS=7        # primary-symbol tape required before a generation runs
#ROBINHOOD_EVOLVE_MAX_TAPE_DAYS=30       # newest days of tape replayed (the tape files keep 45)
#ROBINHOOD_EVOLVE_HOLDOUT_MIN_CLOSES=20  # sealed-holdout (newest 20%) closes a champion needs
#ROBINHOOD_EVOLVE_HOLDOUT_MIN_PF=1.2     # sealed-holdout profit factor a champion needs
#ROBINHOOD_EVOLVE_REQUIRE_RH_QUOTES=true # champions need >= 90% Robinhood-sourced holdout quotes

# Evolution Lab link. Enabled by default; set false only to isolate the trader from the separate Lab backend.
MPO_LAB_LINK=true

# POLYMARKET US COMBOS (docs/POLYMARKET-COMBOS.md): live games about to end, one manual combo, real money.
# Keys come from https://polymarket.us/developer; the Polymarket window's key form writes the first two lines.
# Price floor, minutes left and max legs are owner settings in the window (stored in the combo journal), not env vars.
#POLYMARKET_KEY_ID=
#POLYMARKET_SECRET_KEY=                   # base64 Ed25519 secret; never rendered back into the UI
#POLYMARKET_US_REAL_ENABLED=true          # false blocks arming, so nothing can be quoted or placed
#POLYMARKET_AUTOSTART=true                # false keeps the settlement loop inert (it never places anything)
#POLYMARKET_US_COMBO_MAX_STAKE_USD=25     # ceiling per combo, fees included
#POLYMARKET_US_COMBO_MAX_OPEN=5           # ceiling on open combos
#POLYMARKET_US_COMBO_DAILY_LOSS_CAP_USD=50   # realized loss today that blocks new placements
#POLYMARKET_US_COMBO_PRICE_TOLERANCE=0.02 # max quote price above the estimate that can still be accepted
#POLYMARKET_US_COMBO_FEE_MODE=auto        # auto | curve | standard (auto switches to the combo curve on 2026-09-17)
#POLYMARKET_US_COMBO_BBO=true             # false skips the per-market best-bid/offer refresh (tests only)
#POLYMARKET_US_API=https://api.polymarket.us
#POLYMARKET_US_GATEWAY=https://gateway.polymarket.us
